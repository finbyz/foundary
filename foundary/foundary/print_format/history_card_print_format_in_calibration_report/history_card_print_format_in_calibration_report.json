 "font_size": 14,
 "html": "<style>\r\n   .table {\r\n        width: 100%;\r\n        font-size: 12px;\r\n        border-collapse: collapse; /* ensures Excel-like borders */\r\n    }\r\n .table td, \r\n    .table th {\r\n        border: 1px solid black !important;  /* force cell borders */\r\n        padding: 4px;\r\n        vertical-align: top;\r\n    }\r\n</style>\r\n<div style=\"text-align:center; font-weight:bold; font-size:16px;\">\r\n    RBD ENGINEERS PVT. LTD.\r\n</div>\r\n\r\n<div style=\"text-align:center; font-weight:bold; font-size:14px; margin-top:5px;\">\r\n    CALIBRATION HISTORY CARD FOR GAUGES (TYPE-I)\r\n</div>\r\n\r\n<div style=\"text-align:right; font-size:10px; margin-top:-30px;\">\r\n    Doc No.: Q/MI/03/A <br>\r\n    Rev No.: 0 <br>\r\n    Rev Date: 01.09.2012 <br>\r\n    TEMP -\r\n</div>\r\n\r\n<br>\r\n\r\n<table class=\"table\" style=\"width:100%; font-size:12px; \">\r\n    <tr>\r\n        <td style=\" width:50%; vertical-align:top;\">\r\n            <b>Gauge Description:</b> {{ doc.gauge_description or \"\" }} <br>\r\n            <b>Make:</b> {{ doc.make or \"\" }} <br>\r\n            <b>ID No.:</b> {{ doc.id_no or \"\" }} <br>\r\n            <b>Size: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b> Go: {{ doc.size_go or \"\" }} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; NoGo: {{ doc.size_nogo or \"\" }} <br>\r\n            <b>Calibration Frequency:</b> {{ doc.calibration_frequency or \"\" }} <br>\r\n            <b>Part No. / Name:</b> {{ doc.part_name or \"\" }} <br>\r\n            <b>Acceptance Criteria Go:</b> {{ doc.acceptance_criteria_go or \"\" }} <br>\r\n            <b>No Go:</b> {{ doc.acceptance_criteria_nogo or \"\" }}\r\n        </td>\r\n\r\n        <td style=\" width:50%; vertical-align:top;\">\r\n            <b>Master Instruments used in Calibration:</b><br>\r\n            <b>Make:</b> {{ doc.master_make or \"\" }} <br>\r\n            <b>Range / L.C.:</b> {{ doc.master_range or \"\" }} <br>\r\n            <b>ID No.:</b> {{ doc.master_id_no or \"\" }} <br>\r\n            <b>Ref. of Calibration Procedure:</b> {{ doc.calibration_procedure_ref or \"\" }} <br>\r\n            <b>Calibration Due Date of Master Instruments:</b> {{ doc.master_due_date or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n\r\n\r\n<br>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; text-align:center; font-size:12px;\">\r\n    <tr >\r\n        <th style=\"border:1px solid black; \" rowspan=\"2\">Sr. No.</th>\r\n        <th style=\"border:1px solid black;\" rowspan=\"2\">Date of Calibration</th>\r\n        <th style=\"border:1px solid black;\" colspan=\"2\">Actual Size of Calibration</th>\r\n        <th style=\"border:1px solid black;\" rowspan=\"2\">Due Date of Calibration</th>\r\n        <th style=\"border:1px solid black;\" rowspan=\"2\">Remarks</th>\r\n        <th style=\"border:1px solid black;\" rowspan=\"2\">Sign.</th>\r\n    </tr>\r\n   <tr>\r\n        <th style=\"border:1px solid black; width:10%; text-align:center;\">Go</th>\r\n        <th style=\"border:1px solid black; width:10%; text-align:center;\">NoGo</th>\r\n    </tr>\r\n\r\n    {% for row in doc.calibration_report_reading %}\r\n    <tr>\r\n        <td style=\"border:1px solid black;\">{{ loop.index }}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.date_of_calibration or \"\" }}</td>\r\n        <td style=\"border:1px solid black;text-align:center;\">{{ row.go or \"\" }}</td>\r\n        <td style=\"border:1px solid black;text-align:center;\">{{ row.nogo or \"\" }}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.due_date_of_calibration or \"\" }}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.remarks or \"\" }}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.sign or \"\" }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n</table>\r\n",
