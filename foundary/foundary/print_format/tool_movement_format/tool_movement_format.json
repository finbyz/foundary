 "html": "<style>\r\n    .docket-container {\r\n        /*border: 1px solid black;*/\r\n        padding: 20px;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 13px;\r\n        page-break-inside: avoid;\r\n    }\r\n    .docket-header {\r\n        text-align: center;\r\n        font-weight: bold;\r\n    }\r\n    .docket-header h3 {\r\n        margin: 0;\r\n        font-size: 16px;\r\n    }\r\n    .meta-table, .tools-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n    .meta-table td {\r\n        padding: 3px;\r\n        vertical-align: top;\r\n        font-weight: bold;\r\n        border: none;\r\n    }\r\n    .tools-table {\r\n        border: 1px solid black;\r\n        \r\n    }\r\n    .tools-table th, .tools-table td {\r\n        border: none;\r\n        padding: 5px;\r\n        text-align: center;\r\n        vertical-align: middle;\r\n        word-wrap: break-word;\r\n     \r\n      \r\n    }\r\n    .tools-table th {\r\n        font-weight: bold;\r\n        border:1px solid black;\r\n       \r\n    }\r\n    .tools-table td{\r\n        border-left:1px solid black;\r\n    }\r\n    \r\n    .print-format td, .print-format th {\r\n    vertical-align: top !important;\r\n    padding: 10px !important;\r\n}\r\n   \r\n</style>\r\n\r\n<div class=\"docket-container\">\r\n    <!-- Header -->\r\n    <div class=\"docket-header\">\r\n        <h3>RBD ENGINEERS PVT. LTD.</h3>\r\n        <div>Tools Issue Docket</div>\r\n    </div>\r\n\r\n   <!-- Operation Name and Date -->\r\n<table style=\"margin-top:20px; width:100%;\">\r\n    <tr>\r\n        <td style=\"text-align:left;\"><b>Op. Name :</b> {{ doc.name if doc.name else \"\" }}</td>\r\n        <td style=\"text-align:right;\"><b>Date :</b> {{ frappe.utils.format_date(doc.date, \"dd-MM-yyyy\") if doc.date else \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n    <!-- Tools Table -->\r\n    <table class=\"tools-table\" style=\"margin-top:5px;\">\r\n   \r\n            <tr>\r\n                <th style=\"width:10%;\">Sr. No.</th>\r\n                <th>Description</th>\r\n                <th style=\"width:15%;\">Nos.</th>\r\n            </tr>\r\n        \r\n      \r\n            {% for row in doc.tool_movement_details %}\r\n                {% set tool_data = frappe.get_doc(\"Tool\", row.tool_code) %}\r\n                <tr>\r\n                    <td>{{ loop.index }}</td>\r\n                    <td style=\"text-align:left;\">{{ tool_data.description }}</td>\r\n                    <td></td>\r\n                </tr>\r\n            {% endfor %}\r\n             {% for i in range(5 - doc.tool_movement_details|length) %}\r\n               \r\n                <tr>\r\n                    <td>&nbsp;</td>\r\n                    <td></td>\r\n                    <td></td>\r\n                </tr>\r\n            {% endfor %}\r\n     \r\n     \r\n    </table>\r\n    <table style=\"width:100%; text-align:center; border-collapse: collapse; \">\r\n    <tr style=\"font-weight:600;height:70px;\">\r\n        <td style=\"border-top: none; border-right: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; width:33.33%;\">Operator's Sign </td>\r\n        <td style=\"border-top: none; border-right: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; width:33.33%;\">Authorised by</td>\r\n        <td style=\"border-top: none; border-right: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; width:33.33%;\">Store-keeper</td>\r\n    </tr>\r\n    \r\n</table>\r\n\r\n\r\n</div>\r\n\r\n\r\n",
