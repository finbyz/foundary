 "html": "\r\n<!--<div style=\"text-align:center; font-weight:bold; font-size:16px;\">-->\r\n<!--    RBD ENGINEERS PVT. LTD.-->\r\n<!--</div>-->\r\n\r\n<!--<div style=\"text-align:center; font-weight:bold; font-size:14px; margin-top:5px;\">-->\r\n<!--    CALIBRATION HISTORY CARD FOR GAUGES (TYPE-II)-->\r\n<!--</div>-->\r\n\r\n<style>\r\n\r\n.print-format table >tbody> tr > td.no-padding {\r\n    padding: 0 !important;\r\n \r\n  \r\n}\r\n\r\n</style>\r\n\r\n{% if letter_head %}\r\n    {{ letter_head }}\r\n{% else %}\r\n    <h2 style=\"text-align:center; font-weight:bold;\">\r\n        RBD ENGINEERS PVT. LTD.\r\n    </h2>\r\n{% endif %}\r\n\r\n<div style=\"text-align:right; font-size:10px; margin-top:-30px;\">\r\n    Doc No.: <b>{{doc.name}}</b> <br>\r\n    Rev No.: 0 <br>\r\n    Rev Date: <b>{{ frappe.utils.formatdate(doc.report_date, \"dd-MM-yyyy\") }}</b> <br>\r\n    TEMP -\r\n</div>\r\n\r\n\r\n\r\n<h2 style=\"width:100%;text-align:center; font-weight:bold;;margin-bottom:0%; \" >CALIBRATION HISTORY CARD FOR GAUGES (TYPE-II)</h2>\r\n<!--<table style=\"width:100%; border-collapse:collapse;margin-bottom:0%;\">-->\r\n<!--  <tr>-->\r\n    <!-- LEFT TABLE -->\r\n<!--    <td style=\"width:50%; vertical-align:top; padding:0;\">-->\r\n<!--      <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Gauge Description:</b> {{ doc.gauge_description or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Make:</b> {{ doc.make or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>ID No.:</b> {{ doc.name or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Size:</b> {{ doc.size or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Calibration Frequency:</b>-->\r\n<!--            {% set report_date = frappe.utils.getdate(doc.report_date) %}-->\r\n<!--            {% set due_date = frappe.utils.getdate(doc.due_date) %}-->\r\n<!--            {% set months = (due_date.year - report_date.year) * 12 + (due_date.month - report_date.month) %}-->\r\n<!--            {{ months }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Part No. / Name:</b> {{ doc.part_name or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Acceptance Criteria Go:</b> {{ doc.acceptance_criteria_go or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--      </table>-->\r\n<!--    </td>-->\r\n\r\n    <!-- RIGHT TABLE -->\r\n<!--    <td style=\"width:50%; vertical-align:top; padding:0;\">-->\r\n<!--      <table style=\"width:100%; border-collapse:collapse; font-size:12px;\">-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Master Instruments used in Calibration:</b> {{ doc.master_make or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--         <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Make:</b> {{ doc.make or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>Range / L.C.:</b> {{ doc.master_range or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border:1px solid black; padding:4px;\">-->\r\n<!--            <b>ID No.:</b> {{ doc.name or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n<!--        <tr>-->\r\n<!--          <td style=\"border-left:1px solid black;border-right:1px solid black; padding:4px;\">-->\r\n<!--            <b>Ref. of Calibration Procedure:</b> {{ doc.calibration_procedure_ref or \"\" }}-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n      \r\n    \r\n<!--<table style=\"width:100%; border-collapse:collapse; font-size:12px;\">-->\r\n<!--  <tr>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px;\"><b>Calibration Due Date Of</b></td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">01-08-2025</td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">06-08-2025</td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">23-08-2025</td>-->\r\n<!--  </tr>-->\r\n<!--  <tr>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px;\"><b>Master Instruments</b></td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 1</td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 2</td>-->\r\n<!--    <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 3</td>-->\r\n<!--  </tr>-->\r\n<!--</table>-->\r\n\r\n<!--</table>-->\r\n\r\n<table style=\"width:99.6%; border-collapse:collapse; table-layout:fixed; height:100%;margin-bottom:0.5%;\">\r\n  <tr style=\"vertical-align:top; height:100%; ;\">\r\n    \r\n    <!-- LEFT COLUMN -->\r\n    <td  class=\"no-padding\" style=\"width:49.5%; padding:0%; vertical-align:top; height:100%;  border-bottom:none;\">\r\n      <table style=\"width:99%; border-collapse:collapse; font-size:12px; height:100%;\">\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Gauge Description:</b> {{ doc.gauge_description or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Make:</b> {{ doc.make or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>ID No.:</b> {{ doc.name or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Size:</b> {{ doc.size or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\">\r\n          <b>Calibration Frequency:</b>\r\n          {% set report_date = frappe.utils.getdate(doc.report_date) %}\r\n          {% set due_date = frappe.utils.getdate(doc.due_date) %}\r\n          {% set months = (due_date.year - report_date.year) * 12 + (due_date.month - report_date.month) %}\r\n          {{ months }}\r\n        </td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Part No. / Name:</b> {{ doc.part_no_and_name or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Acceptance Criteria Go:</b> {{ doc.acceptance_criteria_go or \"\" }}</td></tr>\r\n      </table>\r\n    </td>\r\n\r\n    <!-- RIGHT COLUMN -->\r\n    <td class=\"no-padding\" style=\"width:49.5%; vertical-align:top; height:100%;  border-bottom:none;\">\r\n      <table style=\"width:99%; border-collapse:collapse; font-size:12px; height:100%;\">\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Master Instruments used in Calibration:</b> {{ doc.master_instruments_used_in_calibration or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Make:</b> {{ doc.make or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Range / L.C.:</b> {{ doc.range_lc or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black; padding:4px;\"><b>ID No.:</b> {{ doc.name or \"\" }}</td></tr>\r\n        <tr><td style=\"border:1px solid black;border-bottom:none; padding:4px;\"><b>Ref. of Calibration Procedure:</b> {{ doc.ref_of_calibration_procedure or \"\" }}</td></tr>\r\n        <tr  >\r\n          <td   class=\"no-padding\"  style=\" padding:0;\">\r\n            <table   style=\"width:100%; border-collapse:collapse; font-size:12px;\">\r\n            <tr><td style=\"border:1px solid black; padding:4px;\"><b>Calibration Due Date Of:</b> {{ frappe.utils.formatdate(doc.calibration_due_date_of, \"dd-MM-yyyy\") or \"\" }}</td></tr>\r\n                        <tr><td style=\"border:1px solid black; padding:4px;\"><b>Master Instruments:</b> {{ doc.master_instruments or \"\" }}</td></tr>\r\n              <!--<tr>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px;\"><b>Calibration Due Date Of</b></td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">01-08-2025</td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">06-08-2025</td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">23-08-2025</td>-->\r\n              <!--</tr>-->\r\n              <!--<tr>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px;\"><b>Master Instruments</b></td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 1</td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 2</td>-->\r\n              <!--  <td style=\"border:1px solid black; padding:4px; text-align:center;\">tool 3</td>-->\r\n              <!--</tr>-->\r\n            </table>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n\r\n  </tr>\r\n</table>\r\n\r\n\r\n<table style=\"width:99%; border-collapse:collapse; text-align:center; font-size:12px;\">\r\n    <tr>\r\n        <th style=\"border:1px solid black; text-align:center; vertical-align:middle;\" rowspan=\"2\">Sr. No.</th>\r\n        <th style=\"border:1px solid black; text-align:center; vertical-align:middle;\" rowspan=\"2\">Date of Calibration</th>\r\n        <th style=\"border:1px solid black; text-align:center; vertical-align:middle;\" colspan=\"2\">Actual Size of Calibration</th>\r\n        <th style=\"border:1px solid black; text-align:center; vertical-align:middle;\" rowspan=\"2\">Due Date of Calibration</th>\r\n        <th style=\"border:1px solid black; text-align:center; vertical-align:middle;\" rowspan=\"2\">Remarks</th>\r\n        <th style=\"width:15%;border:1px solid black; text-align:center; vertical-align:middle;\" rowspan=\"2\">Sign.</th>\r\n    </tr>\r\n    <tr>\r\n        <th style=\"width:15%;border:1px solid black; text-align:center; vertical-align:middle;\">Go</th>\r\n        <th style=\"width:15%;border:1px solid black; text-align:center; vertical-align:middle;\">NoGo</th>\r\n    </tr>\r\n\r\n    \r\n{% if doc.calibration_report_reading and doc.calibration_report_reading|length > 0 %}\r\n    {% for row in doc.calibration_report_reading %}\r\n    <tr>\r\n        <td style=\"border:1px solid black;\">{{ loop.index }}</td>\r\n        <td style=\"border:1px solid black;\">{{ frappe.utils.formatdate(doc.report_date, \"dd-MM-yyyy\") or \"\"}}</td>\r\n        <td style=\"border:1px solid black;text-align:center;\">{{ row.minimum_value or 0 }}</td>\r\n        <td style=\"border:1px solid black;text-align:center;\">{{ row.maximum_value or \"\" }}</td>\r\n        <td style=\"border:1px solid black;\">{{ frappe.utils.formatdate(doc.due_date, \"dd-MM-yyyy\") or \"\"}}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.remarks or \"\" }}</td>\r\n        <td style=\"border:1px solid black;\">{{ row.sign or \"\" }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n\r\n    {# Add empty rows to make total = 10 #}\r\n    {% for i in range(10) %}\r\n    <tr>\r\n        <td style=\"border:1px solid black;\">&nbsp;</td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n    </tr>\r\n    {% endfor %}\r\n{% else %}\r\n    {# If no records at all, show 10 empty rows #}\r\n    {% for i in range(10) %}\r\n    <tr>\r\n        <td style=\"border:1px solid black;\">&nbsp;</td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n        <td style=\"border:1px solid black;\"></td>\r\n    </tr>\r\n    {% endfor %}\r\n{% endif %}\r\n</table>\r\n",
